{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ledger.techassembly.io/schema/0.1.0",
  "title": "Open Ledger event",
  "description": "A portable operational event for an informal or small business.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "occurred_at",
    "recorded_at",
    "subject",
    "source",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable unique event id."
    },
    "type": {
      "enum": [
        "order.created",
        "payment.received",
        "stock.received",
        "stock.sold",
        "stock.adjusted"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the event happened in the real world."
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the record was created."
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "counterparty": {
      "$ref": "#/$defs/counterparty"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code when the event carries money."
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 0,
      "description": "Money in integer minor units (kobo, cents, pesewas)."
    },
    "payload": {
      "type": "object",
      "description": "Type-specific fields. See SPEC.md §4."
    },
    "metadata": {
      "type": "object",
      "description": "Implementation-specific extensions, namespaced by the implementer."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "order.created" } } },
      "then": {
        "required": ["currency", "amount_minor"],
        "properties": { "payload": { "$ref": "#/$defs/orderPayload" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "payment.received" } } },
      "then": {
        "required": ["currency", "amount_minor"],
        "properties": { "payload": { "$ref": "#/$defs/paymentPayload" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "stock.received" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/stockPayload" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "stock.sold" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/stockPayload" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "stock.adjusted" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/adjustmentPayload" } }
      }
    }
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_id"],
      "properties": {
        "business_id": { "type": "string", "minLength": 1 },
        "location_id": { "type": "string" },
        "business_name": { "type": "string" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["owner", "staff", "system", "integration"] },
        "name": { "type": "string" }
      }
    },
    "counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["customer", "supplier", "partner", "other"] },
        "name": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel"],
      "properties": {
        "channel": { "enum": ["whatsapp", "voice", "pos", "paper", "api", "import", "manual"] },
        "evidence_id": { "type": "string" },
        "raw_text": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "quantity", "unit"],
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "unit_price_minor": { "type": "integer", "minimum": 0 }
      }
    },
    "stockItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "quantity", "unit"],
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "unit_cost_minor": { "type": "integer", "minimum": 0 }
      }
    },
    "orderPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["order_id", "line_items"],
      "properties": {
        "order_id": { "type": "string", "minLength": 1 },
        "line_items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lineItem" }
        },
        "fulfilment": { "enum": ["pickup", "delivery", "digital", "other"] },
        "note": { "type": "string" }
      }
    },
    "paymentPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["payment_id", "method"],
      "properties": {
        "payment_id": { "type": "string", "minLength": 1 },
        "order_id": { "type": "string" },
        "method": { "enum": ["cash", "bank_transfer", "card", "mobile_money", "cheque", "other"] },
        "reference": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "stockPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stockItem" }
        },
        "supplier": { "type": "string" },
        "order_id": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "adjustmentPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items", "reason"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stockItem" }
        },
        "reason": { "enum": ["damage", "theft", "expiry", "count_correction", "other"] },
        "note": { "type": "string" }
      }
    }
  }
}
